{
  "model": "Task",
  "tasks": [
    {
      "name": "Prove Statement with Resolution Theorem Proving",
      "description": "Prove a logical statement by refutation using Resolution Theorem Proving.",
      "inputParameters": [
        "knowledgeBase: list<logical_sentence>",
        "goalStatement: logical_sentence"
      ],
      "outputParameters": [
        "proofResult: boolean"
      ],
      "given": "is_valid(knowledgeBase) && is_valid(goalStatement)",
      "makes": "is_proven(goalStatement, proofResult)",
      "means": [
        {
          "mechanismReference": "Resolution Theorem Proving Mechanism",
          "actualArguments": [
            "knowledgeBase",
            "goalStatement"
          ]
        }
      ]
    },
