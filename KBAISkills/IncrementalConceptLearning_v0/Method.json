    {
      "name": "specialize_using_forbid_link",
      "description": "Add forbidden relationship to exclude negative example",
      "inputParameters": [
        "current_concept_definition: current_concept_definition",
        "negative_example: negative_example"
      ],
      "outputParameters": [
        "specialized_concept_definition: specialized_concept_definition"
      ],
      "requires": "negative example has unwanted relationship not in positive examples",
