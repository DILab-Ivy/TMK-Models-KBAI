      "organizer": {
        "startState": "IdentifyUnwantedLink",
        "successState": "LinkForbidden",
        "failureState": "Fail",
        "states": [
          {
            "name": "IdentifyUnwantedLink",
            "goalInvocation": {
              "goalReference": "identify_unwanted_link",
