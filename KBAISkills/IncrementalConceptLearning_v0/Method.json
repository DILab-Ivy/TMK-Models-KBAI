            "sourceState": "IdentifyNewValue",
            "targetState": "Fail",
            "dataCondition": "new_value_found == false"
          },
          {
            "sourceState": "AddValueToSet",
            "targetState": "SetEnlarged",
            "dataCondition": "value_added_successfully == true"
          },
          {
            "sourceState": "AddValueToSet",
