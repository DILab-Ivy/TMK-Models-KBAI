              "actualArguments": []
            }
          }
        ],
        "transitions": [
          {
            "sourceState": "IdentifyMissingLink",
            "targetState": "MarkAsRequired",
            "dataCondition": "missing_link_found == true"
          },
          {
            "sourceState": "IdentifyMissingLink",
            "targetState": "Fail",
            "dataCondition": "missing_link_found == false"
          },
          {
            "sourceState": "MarkAsRequired",
            "targetState": "LinkRequired",
            "dataCondition": "link_marked_successfully == true"
          },
          {
            "sourceState": "MarkAsRequired",
            "targetState": "Fail",
            "dataCondition": "link_marked_successfully == false"
          }
        ]
      }
