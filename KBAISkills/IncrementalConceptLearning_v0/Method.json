          {
            "name": "Fail",
            "goalInvocation": {
              "goalReference": "CoverageCheckFailed",
              "type": "task",
              "actualArguments": []
            }
          }
        ],
        "transitions": [
          {
            "sourceState": "MatchStructure",
            "targetState": "CoverageChecked",
            "dataCondition": "structure_match_result != null"
          },
          {
            "sourceState": "MatchStructure",
            "targetState": "Fail",
            "dataCondition": "structure_match_result == null"
          }
        ]
      }
    },
    {
      "name": "generalize_using_drop_link",
      "description": "Remove unnecessary link to generalize concept",
      "inputParameters": [
        "current_concept_definition: current_concept_definition",
        "positive_example: positive_example"
      ],
      "outputParameters": [
        "generalized_concept_definition: generalized_concept_definition"
      ],
      "requires": "structures overlap except for one extra link in current definition",
