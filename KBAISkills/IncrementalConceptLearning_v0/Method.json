                "positive_example"
              ]
            }
          },
          {
            "name": "RemoveLink",
            "goalInvocation": {
              "goalReference": "remove_link_from_definition",
              "type": "task",
              "actualArguments": [
                "current_concept_definition",
                "extra_link"
              ]
            }
          },
          {
            "name": "LinkDropped",
            "goalInvocation": {
              "goalReference": "return_generalized_definition",
              "type": "task",
              "actualArguments": [
                "generalized_concept_definition"
              ]
            }
          },
          {
            "name": "Fail",
            "goalInvocation": {
              "goalReference": "heuristic_not_applicable",
              "type": "task",
              "actualArguments": []
            }
          }
        ],
        "transitions": [
          {
            "sourceState": "IdentifyExtraLink",
            "targetState": "RemoveLink",
            "dataCondition": "extra_link_found == true"
          },
          {
            "sourceState": "IdentifyExtraLink",
            "targetState": "Fail",
            "dataCondition": "extra_link_found == false"
          },
          {
            "sourceState": "RemoveLink",
            "targetState": "LinkDropped",
            "dataCondition": "link_removed_successfully == true"
          },
          {
            "sourceState": "RemoveLink",
            "targetState": "Fail",
            "dataCondition": "link_removed_successfully == false"
          }
        ]
      }
    },
