{
  "model": "Method",
  "methods": [
    {
      "name": "learn_concept_incrementally",
      "description": "Learn a concept definition from a sequence of labeled examples using variabilization, generalization, and specialization",
      "inputParameters": [
        "example_sequence: example_sequence",
        "background_knowledge: background_knowledge"
      ],
      "outputParameters": [
        "concept_definition: concept_definition"
      ],
      "requires": "examples are labeled as positive or negative",
      "provides": "concept definition covers all positive examples and excludes all negative examples",
      "organizer": {
        "startState": "VariabilizeFirst",
        "successState": "ConceptDefined",
        "failureState": "Fail",
        "states": [
          {
            "name": "VariabilizeFirst",
            "goalInvocation": {
              "goalReference": "variabilize_first_example",
              "type": "task",
              "actualArguments": [
                "first_positive_example"
              ]
            }
          },
          {
            "name": "CheckLabel",
            "goalInvocation": {
              "goalReference": "check_example_label",
              "type": "task",
              "actualArguments": [
                "labeled_example"
              ]
            }
          },
          {
            "name": "ProcessPositive",
            "goalInvocation": {
              "goalReference": "process_positive_example",
              "type": "task",
              "actualArguments": [
                "positive_example",
                "current_concept_definition",
                "background_knowledge"
              ]
            }
          },
          {
            "name": "ProcessNegative",
            "goalInvocation": {
              "goalReference": "process_negative_example",
              "type": "task",
              "actualArguments": [
                "negative_example",
                "current_concept_definition"
              ]
            }
          },
          {
            "name": "CheckMoreExamples",
            "goalInvocation": {
              "goalReference": "check_if_more_examples_remain",
              "type": "task",
              "actualArguments": [
                "current_example_index",
                "total_examples"
              ]
            }
          },
          {
            "name": "ConceptDefined",
            "goalInvocation": {
              "goalReference": "return_concept_definition",
              "type": "task",
              "actualArguments": [
                "concept_definition"
              ]
            }
          },
          {
            "name": "Fail",
            "goalInvocation": {
              "goalReference": "LearningFailed",
              "type": "task",
              "actualArguments": []
            }
          }
        ],
        "transitions": [
          {
            "sourceState": "VariabilizeFirst",
            "targetState": "CheckLabel",
            "dataCondition": "first_positive_example != null"
          },
          {
            "sourceState": "VariabilizeFirst",
            "targetState": "Fail",
            "dataCondition": "first_positive_example == null"
          },
          {
            "sourceState": "CheckLabel",
            "targetState": "ProcessPositive",
            "dataCondition": "labeled_example.label == positive"
          },
          {
            "sourceState": "CheckLabel",
            "targetState": "ProcessNegative",
            "dataCondition": "labeled_example.label == negative"
          },
          {
            "sourceState": "CheckLabel",
            "targetState": "Fail",
            "dataCondition": "labeled_example.label != positive && labeled_example.label != negative"
          },
          {
            "sourceState": "ProcessPositive",
            "targetState": "CheckMoreExamples",
            "dataCondition": "current_example_index <= total_examples"
          },
          {
            "sourceState": "ProcessPositive",
            "targetState": "Fail",
            "dataCondition": "updated_concept_definition == null"
          },
          {
            "sourceState": "ProcessNegative",
            "targetState": "CheckMoreExamples",
            "dataCondition": "current_example_index <= total_examples"
          },
          {
            "sourceState": "ProcessNegative",
            "targetState": "Fail",
            "dataCondition": "updated_concept_definition == null"
          },
          {
            "sourceState": "CheckMoreExamples",
            "targetState": "ConceptDefined",
            "dataCondition": "current_example_index >= total_examples"
          },
          {
            "sourceState": "CheckMoreExamples",
            "targetState": "Fail",
            "dataCondition": "current_example_index == null || total_example == null"
          }
        ]
      }
    },
    {
      "name": "variabilize_first_example",
      "description": "Convert constants to variables in the first positive example",
      "inputParameters": [
        "first_positive_example: first_positive_example"
      ],
      "outputParameters": [
        "initial_concept_definition: initial_concept_definition"
      ],
      "requires": "this is the first example with constants",
      "provides": "initial concept definition with variables",
      "organizer": {
        "startState": "ExtractConstants",
        "successState": "InitialDefinitionCreated",
        "failureState": "Fail",
        "states": [
          {
            "name": "ExtractConstants",
            "goalInvocation": {
              "goalReference": "extract_constants_from_example",
              "type": "task",
              "actualArguments": [
                "first_positive_example"
              ]
            }
          },
          {
            "name": "ReplaceWithVariables",
            "goalInvocation": {
              "goalReference": "replace_constants_with_variables",
              "type": "task",
              "actualArguments": [
                "example_constants",
                "variable_types"
              ]
            }
          },
          {
            "name": "InitialDefinitionCreated",
            "goalInvocation": {
              "goalReference": "return_initial_concept_definition",
              "type": "task",
              "actualArguments": [
                "initial_concept_definition"
              ]
            }
          },
          {
            "name": "Fail",
            "goalInvocation": {
              "goalReference": "VariabilizationFailed",
              "type": "task",
              "actualArguments": []
            }
          }
        ],
        "transitions": [
          {
            "sourceState": "ExtractConstants",
            "targetState": "ReplaceWithVariables",
            "dataCondition": "example_constants != null"
          },
          {
            "sourceState": "ExtractConstants",
            "targetState": "Fail",
            "dataCondition": "example_constants == null"
          },
          {
            "sourceState": "ReplaceWithVariables",
            "targetState": "InitialDefinitionCreated",
            "dataCondition": "initial_concept_definition != null"
          },
          {
            "sourceState": "ReplaceWithVariables",
            "targetState": "Fail",
            "dataCondition": "initial_concept_definition == null"
          }
        ]
      }
    },
    {
      "name": "process_positive_example",
      "description": "Update concept definition to cover positive example",
      "inputParameters": [
        "positive_example: positive_example",
        "current_concept_definition: current_concept_definition",
        "background_knowledge: background_knowledge"
      ],
      "outputParameters": [
        "updated_concept_definition: updated_concept_definition"
      ],
      "requires": "example is a positive instance",
      "provides": "concept definition covers this positive example",
      "organizer": {
        "startState": "CheckCoverage",
        "successState": "DefinitionUpdated",
        "failureState": "Fail",
        "states": [
          {
            "name": "CheckCoverage",
            "goalInvocation": {
              "goalReference": "check_coverage",
              "type": "task",
              "actualArguments": [
                "positive_example",
                "current_concept_definition"
              ]
            }
          },
          {
            "name": "DoNothing",
            "goalInvocation": {
              "goalReference": "do_nothing",
              "type": "task",
              "actualArguments": []
            }
          },
          {
            "name": "TryDropLink",
            "goalInvocation": {
              "goalReference": "generalize_using_drop_link",
              "type": "task",
              "actualArguments": [
                "current_concept_definition",
                "positive_example"
              ]
            }
          },
          {
            "name": "TryEnlargeSet",
            "goalInvocation": {
              "goalReference": "generalize_using_enlarge_set",
              "type": "task",
              "actualArguments": [
                "current_concept_definition",
                "positive_example"
              ]
            }
          },
          {
            "name": "TryClimbTree",
            "goalInvocation": {
              "goalReference": "generalize_using_climb_tree",
              "type": "task",
              "actualArguments": [
                "current_concept_definition",
                "background_knowledge"
              ]
            }
          },
          {
            "name": "DefinitionUpdated",
            "goalInvocation": {
              "goalReference": "return_updated_definition",
              "type": "task",
              "actualArguments": [
                "updated_concept_definition"
              ]
            }
          },
          {
            "name": "Fail",
            "goalInvocation": {
              "goalReference": "GeneralizationFailed",
              "type": "task",
              "actualArguments": []
            }
          }
        ],
        "transitions": [
          {
            "sourceState": "CheckCoverage",
            "targetState": "DoNothing",
            "dataCondition": "coverage_result == true"
          },
          {
            "sourceState": "CheckCoverage",
            "targetState": "TryDropLink",
            "dataCondition": "coverage_result == false"
          },
          {
            "sourceState": "CheckCoverage",
            "targetState": "Fail",
            "dataCondition": "coverage_result == null || current_concept_definition == null"
          },
          {
            "sourceState": "TryDropLink",
            "targetState": "DefinitionUpdated",
            "dataCondition": "drop_link_applicable == true"
          },
          {
            "sourceState": "TryDropLink",
            "targetState": "TryEnlargeSet",
            "dataCondition": "drop_link_applicable == false"
          },
          {
            "sourceState": "TryDropLink",
            "targetState": "Fail",
            "dataCondition": "drop_link_applicable == null || current_concept_definition == null"
          },
          {
            "sourceState": "TryEnlargeSet",
            "targetState": "DefinitionUpdated",
            "dataCondition": "enlarge_set_applicable == true"
          },
          {
            "sourceState": "TryEnlargeSet",
            "targetState": "TryClimbTree",
            "dataCondition": "enlarge_set_applicable == false"
          },
          {
            "sourceState": "TryEnlargeSet",
            "targetState": "Fail",
            "dataCondition": "enlarge_set_applicable == null || current_concept_definition == null"
          },
          {
            "sourceState": "TryClimbTree",
            "targetState": "DefinitionUpdated",
            "dataCondition": "climb_tree_applicable == true"
          },
          {
            "sourceState": "TryClimbTree",
            "targetState": "Fail",
            "dataCondition": "climb_tree_applicable == false"
          }
        ]
      }
    },
    {
      "name": "process_negative_example",
      "description": "Update concept definition to exclude negative example",
      "inputParameters": [
        "negative_example: negative_example",
        "current_concept_definition: current_concept_definition"
      ],
      "outputParameters": [
        "updated_concept_definition: updated_concept_definition"
      ],
      "requires": "example is a negative instance",
      "provides": "concept definition excludes this negative example",
      "organizer": {
        "startState": "CheckCoverage",
        "successState": "DefinitionUpdated",
        "failureState": "Fail",
        "states": [
          {
            "name": "CheckCoverage",
            "goalInvocation": {
              "goalReference": "check_coverage",
              "type": "task",
              "actualArguments": [
                "negative_example",
                "current_concept_definition"
              ]
            }
          },
          {
            "name": "DoNothing",
            "goalInvocation": {
              "goalReference": "do_nothing",
              "type": "task",
              "actualArguments": []
            }
          },
          {
            "name": "TryRequireLink",
            "goalInvocation": {
              "goalReference": "specialize_using_require_link",
              "type": "task",
              "actualArguments": [
                "current_concept_definition",
                "negative_example"
              ]
            }
          },
          {
            "name": "TryForbidLink",
            "goalInvocation": {
              "goalReference": "specialize_using_forbid_link",
              "type": "task",
              "actualArguments": [
                "current_concept_definition",
                "negative_example"
              ]
            }
          },
          {
            "name": "DefinitionUpdated",
            "goalInvocation": {
              "goalReference": "return_updated_definition",
              "type": "task",
              "actualArguments": [
                "updated_concept_definition"
              ]
            }
          },
          {
            "name": "Fail",
            "goalInvocation": {
              "goalReference": "SpecializationFailed",
              "type": "task",
              "actualArguments": []
            }
          }
        ],
        "transitions": [
          {
            "sourceState": "CheckCoverage",
            "targetState": "DoNothing",
            "dataCondition": "coverage_result == false"
          },
          {
            "sourceState": "CheckCoverage",
            "targetState": "TryRequireLink",
            "dataCondition": "coverage_result == true"
          },
          {
            "sourceState": "CheckCoverage",
            "targetState": "Fail",
            "dataCondition": "coverage_result == null || current_concept_definition == null"
          },
          {
            "sourceState": "TryRequireLink",
            "targetState": "DefinitionUpdated",
            "dataCondition": "require_link_applicable == true"
          },
          {
            "sourceState": "TryRequireLink",
            "targetState": "TryForbidLink",
            "dataCondition": "require_link_applicable == false"
          },
          {
            "sourceState": "TryRequireLink",
            "targetState": "Fail",
            "dataCondition": "require_link_applicable == null || current_concept_definition == null"
          },
          {
            "sourceState": "TryForbidLink",
            "targetState": "DefinitionUpdated",
            "dataCondition": "forbid_link_applicable == true"
          },
          {
            "sourceState": "TryForbidLink",
            "targetState": "Fail",
            "dataCondition": "forbid_link_applicable == false"
          }
        ]
      }
    },
    {
