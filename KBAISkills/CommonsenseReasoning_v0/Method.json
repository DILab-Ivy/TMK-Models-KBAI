{
  "model": "Method",
  "methods": [
    {
      "name": "MapSentenceToFrame",
      "description": "Map a natural-language sentence to a typed frame representation and paraphrase.",
      "inputs": [
        "s: Sentence",
        "ont: Ontology",
        "parser: TextParser",
        "lex: FrameLexicon",
        "checker: SemanticChecker",
        "paraphraser: Paraphraser"
      ],
      "outputs": [
        "fi: FrameInstance",
        "p: Paraphrase"
      ],
      "requires": [
        "s.text != \"\"",
        "ont.version != \"\""
      ],
      "provides": [
        "isType(FrameInstance, fi)",
        "isType(Paraphrase, p)"
      ],
      "operations": [
        {
          "name": "retrieveOntology",
          "inputs": [
            "ont: Ontology"
          ],
          "requires": [
            "ont.version != \"\""
          ],
          "provides": [
            "true"
          ]
        },
        {
          "name": "parseSentence",
          "inputs": [
            "parser: TextParser",
            "s: Sentence"
          ],
          "outputs": [
            "tokens: Set<Token>",
            "deps: Set<Dependency>"
          ],
          "requires": [
            "isType(TextParser, parser)",
            "isType(Sentence, s)"
          ],
          "provides": [
            "Count(tokens) > 0"
          ]
        },
        {
          "name": "identifyMainVerb",
          "inputs": [
            "tokens: Set<Token>"
          ],
          "outputs": [
            "verb: Token"
          ],
          "requires": [
            "Count(tokens) > 0"
          ],
          "provides": [
            "verb.pos == \"VERB\""
          ]
        },
        {
          "name": "mapVerbToFrame",
          "inputs": [
            "lex: FrameLexicon",
            "verb: Token"
          ],
          "outputs": [
            "candidateFrames: Set<Frame>"
          ],
          "requires": [
            "isType(FrameLexicon, lex)",
            "isType(Token, verb)"
          ],
          "provides": [
            "Count(candidateFrames) >= 1"
          ]
        },
        {
          "name": "selectFrame",
          "inputs": [
            "candidateFrames: Set<Frame>",
            "s: Sentence"
          ],
          "outputs": [
            "frame: Frame"
          ],
          "requires": [
            "Count(candidateFrames) >= 1"
          ],
          "provides": [
            "isType(Frame, frame)"
          ]
        },
        {
          "name": "fillFrameSlots",
          "inputs": [
            "frame: Frame",
            "s: Sentence",
            "deps: Set<Dependency>"
          ],
          "outputs": [
            "fi: FrameInstance"
          ],
          "requires": [
            "isType(Frame, frame)"
          ],
          "provides": [
            "isType(FrameInstance, fi)"
          ]
        },
        {
          "name": "checkSemanticConstraints",
          "inputs": [
            "checker: SemanticChecker",
            "fi: FrameInstance"
          ],
          "outputs": [
            "ok: BOOLEAN",
            "violations: Set<STRING>"
          ],
          "requires": [
            "isType(FrameInstance, fi)"
          ],
          "provides": [
            "ok == true or Count(violations) >= 1"
          ]
        },
        {
          "name": "paraphrase",
          "inputs": [
            "paraphraser: Paraphraser",
            "fi: FrameInstance"
          ],
          "outputs": [
            "p: Paraphrase"
          ],
          "requires": [
            "isType(FrameInstance, fi)"
          ],
          "provides": [
            "isType(Paraphrase, p) and p.text != \"\""
          ]
        },
        {
          "name": "translateSentence",
          "mechanismReference": "Manual_Method.translate_sentence",
          "inputs": [
            "s: Sentence"
          ],
          "outputs": [
            "s2: Sentence"
          ],
          "requires": [
            "true"
          ],
          "provides": [
            "s2.text != \"\""
          ]
        },
        {
          "name": "evaluateAndRefine",
          "mechanismReference": "Manual_Method.evaluate_and_refine_step",
          "inputs": [
            "fi: FrameInstance",
            "s: Sentence"
          ],
          "outputs": [
            "refined: BOOLEAN"
          ],
          "requires": [
            "isType(FrameInstance, fi)"
          ],
          "provides": [
            "refined in {true,false}"
          ]
        }
      ],
      "fsm": {
        "states": [
          "Start",
          "Parsed",
          "VerbIdentified",
          "FrameChosen",
          "SlotsFilled",
          "Checked",
          "Paraphrased",
          "Success",
          "Fail"
        ],
        "start": "Start",
        "success": "Success",
        "failure": "Fail",
        "transitions": {
          "Start": [
            {
              "guard": "ont.version != \"\"",
              "action": "retrieveOntology",
              "to": "Parsed"
            },
            {
              "guard": "else",
              "action": "finalize",
              "to": "Fail"
            }
          ],
          "Parsed": [
            {
              "guard": "verb.pos == \"VERB\"",
              "action": "identifyMainVerb",
              "to": "VerbIdentified"
            },
            {
              "guard": "else",
              "action": "finalize",
              "to": "Fail"
            }
          ],
          "VerbIdentified": [
            {
              "guard": "candidate != null",
              "action": "mapVerbToFrame",
              "to": "FrameChosen"
            },
            {
              "guard": "candidate == null",
              "action": "translateSentence",
              "to": "Parsed"
            },
            {
              "guard": "else",
              "action": "finalize",
              "to": "Fail"
            }
          ],
          "FrameChosen": [
            {
              "guard": "isType(FrameInstance, fi)",
              "action": "fillFrameSlots",
              "to": "SlotsFilled"
            },
            {
              "guard": "else",
              "action": "finalize",
              "to": "Fail"
            }
          ],
          "SlotsFilled": [
            {
              "guard": "true",
              "action": "evaluateAndRefine",
              "to": "Checked"
            },
            {
              "guard": "else",
              "action": "finalize",
              "to": "Fail"
            }
          ],
          "Checked": [
            {
              "guard": "p.text != \"\"",
              "action": "paraphrase",
              "to": "Paraphrased"
            },
            {
              "guard": "else",
              "action": "finalize",
              "to": "Fail"
            }
          ],
          "Paraphrased": [
            {
              "guard": "true",
              "action": "finalize",
              "to": "Success"
            },
            {
              "guard": "else",
              "action": "finalize",
              "to": "Fail"
            }
          ]
        }
      },
      "assertions": [
        {
          "name": "WellTypedFI",
          "logic": "isType(FrameInstance, fi) -> forall(slot in fi.assignments) isType(slot.role, Role)"
        },
        {
          "name": "ParaphraseNonEmpty",
          "logic": "isType(Paraphrase, p) -> p.text != \"\""
        },
        {
          "name": "JudgementRange",
          "logic": "isType(Judgement, j) -> 0.0 <= j.confidence <= 1.0"
        }
      ],
      "stateInvocations": {
        "Success": {
          "goalInvocation": {
            "task": "SafetyValidationGoal",
            "inputs": [
              "fi: FrameInstance",
              "ont: Ontology"
            ],
            "type": "Task"
          }
        },
        "Fail": {
          "goalInvocation": {
            "task": "FailureGoal",
            "inputs": [
              "context"
            ],
            "type": "Task"
          }
        }
      }
    },
    {
      "name": "MakeCommonsenseInference",
      "description": "Evaluate a frame instance against the ontology to produce a judgement (entailed/plausible/unknown/contradictory).",
      "inputs": [
        "fi: FrameInstance",
        "ont: Ontology"
      ],
      "outputs": [
        "j: Judgement"
      ],
      "requires": [
        "isType(FrameInstance, fi)",
        "isType(Ontology, ont)"
      ],
      "provides": [
        "isType(Judgement, j)",
        "j.status in {\"entailed\",\"plausible\",\"unknown\",\"contradictory\"}"
      ],
      "operations": [
        {
          "name": "evaluateCommonsense",
          "inputs": [
            "fi: FrameInstance",
            "ont: Ontology"
          ],
          "outputs": [
            "j: Judgement"
          ],
          "requires": [
            "isType(FrameInstance, fi)",
            "isType(Ontology, ont)"
          ],
          "provides": [
            "isType(Judgement, j)"
          ]
        }
      ],
      "fsm": {
        "states": [
          "Start",
          "Evaluated",
          "Success",
          "Fail"
        ],
        "start": "Start",
        "success": "Success",
        "failure": "Fail",
        "transitions": {
          "Start": [
            {
              "guard": "isType(Judgement, j)",
              "action": "evaluateCommonsense",
              "to": "Evaluated"
            },
            {
              "guard": "else",
              "action": "finalize",
              "to": "Fail"
            }
          ],
          "Evaluated": [
            {
              "guard": "j.status in {\"entailed\",\"plausible\",\"contradictory\"}",
              "action": "finalize",
              "to": "Success"
            },
            {
              "guard": "j.status == \"unknown\"",
              "action": "finalize",
              "to": "Success"
            },
            {
              "guard": "else",
              "action": "finalize",
              "to": "Fail"
            }
          ]
        }
      },
      "assertions": [
        {
          "name": "WellTypedFI",
          "logic": "isType(FrameInstance, fi) -> forall(slot in fi.assignments) isType(slot.role, Role)"
        },
        {
          "name": "ParaphraseNonEmpty",
          "logic": "isType(Paraphrase, p) -> p.text != \"\""
        },
        {
          "name": "JudgementRange",
          "logic": "isType(Judgement, j) -> 0.0 <= j.confidence <= 1.0"
        }
      ],
      "stateInvocations": {
        "Success": {
          "goalInvocation": {
            "task": "SafetyValidationGoal",
            "inputs": [
              "fi: FrameInstance",
              "ont: Ontology"
            ],
            "type": "Task"
          }
        },
        "Fail": {
          "goalInvocation": {
            "task": "FailureGoal",
            "inputs": [
              "context"
            ],
            "type": "Task"
          }
        }
      }
    }
  ],
