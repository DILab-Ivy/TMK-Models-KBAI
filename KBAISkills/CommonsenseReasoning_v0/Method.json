  "assertions": [
    {
      "name": "safe(fi, ont)",
      "logic": "safe(fi, ont)  <->  (roles_well_typed(fi) \u2227 role_completeness(fi) \u2227 not_contradictory(fi, ont))",
      "mapsTo": {
        "task": "SafetyValidationGoal"
      },
      "description": "Skill-level safety predicate over a FrameInstance under an Ontology."
    },
    {
      "name": "roles_well_typed(fi)",
      "logic": "roles_well_typed(fi)  <->  \u2200 slot \u2208 fi.assignments : isType(slot.role, Role) \u2227 conformsType(slot.filler, slot.role.expectedType)",
      "mapsTo": {
        "mechanism": "fillFrameSlots"
      },
      "description": "All role fillers match their expected concept types."
    },
    {
      "name": "role_completeness(fi)",
      "logic": "role_completeness(fi)  <->  RequiredRoles(fi.frame) \u2286 {slot.role | slot \u2208 fi.assignments}",
      "mapsTo": {
        "mechanism": "fillFrameSlots"
      },
      "description": "All required frame roles are present."
    },
    {
      "name": "not_contradictory(fi, ont)",
      "logic": "not_contradictory(fi, ont)  <->  MakeCommonsenseInference(fi, ont).j.status \u2260 \"contradictory\"",
      "mapsTo": {
        "method": "MakeCommonsenseInference"
      },
      "description": "Inferred judgement is not contradictory under the ontology."
    },
    {
      "name": "paraphrase_ok(p)",
      "logic": "paraphrase_ok(p)  <->  (isType(Paraphrase, p) \u2227 p.text \u2260 \"\")",
      "mapsTo": {
        "mechanism": "paraphrase"
      },
      "description": "Paraphrase exists and is non-empty."
    },
    {
      "name": "frame_selection_consistent(verb, frame)",
      "logic": "frame_selection_consistent(verb, frame)  <->  frame \u2208 LexicalCandidates(verb) \u2228 TranslateThenMap(verb)",
      "mapsTo": {
        "mechanism": "mapVerbToFrame"
      },
      "description": "Chosen frame is licensed by lexicon or via translation-then-map fallback."
    },
    {
      "name": "ambiguity_resolved(s, fi)",
      "logic": "ambiguity_resolved(s, fi)  <->  (UniqueSense(fi.frame) \u2228 ContextProvidesDisambiguation(s, fi))",
      "mapsTo": {
        "mechanism": "evaluateAndRefine"
      },
      "description": "Either only one sense is viable or context refinements disambiguate."
    },
    {
      "name": "entailed_sentences(fi, ont, S)",
      "logic": "entailed_sentences(fi, ont, S)  <->  S = GenerateEntailedSentencesOp(fi, ont)",
      "mapsTo": {
        "mechanism": "GenerateEntailedSentencesOp"
      },
      "description": "Set S is the result of surface realizing entailments."
    },
    {
      "name": "j_ok(j)",
      "logic": "j_ok(j)  <->  (j.status \u2208 {\"entailed\",\"plausible\",\"unknown\",\"contradictory\"} \u2227 0.0 \u2264 j.confidence \u2264 1.0)",
      "mapsTo": {
        "mechanism": "EvaluateCommonsenseOp"
      },
      "description": "Judgement has a valid label and confidence range."
    },
    {
      "name": "tokens_present(tokens)",
      "logic": "tokens_present(tokens)  <->  Count(tokens) > 0",
      "mapsTo": {
        "mechanism": "identifyMainVerb"
      },
      "description": "Parser produced at least one token."
    }
  ]
}