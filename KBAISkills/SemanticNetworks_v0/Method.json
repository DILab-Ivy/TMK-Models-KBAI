    {
      "name": "EmbarkGuard",
      "description": "Embarks a guard onto the boat.",
      "inputParameters": ["b: boat", "g: guard", "c: configuration"],
      "outputParameters": ["c': configuration"],
      "requires": "b.occupancy < 2",
      "provides": "c'.boat.occupancy = c.boat.occupancy + 1"
    },
    {
      "name": "EmbarkPrisoner",
      "description": "Embarks a prisoner onto the boat.",
      "inputParameters": ["b: boat", "p: prisoner", "c: configuration"],
      "outputParameters": ["c': configuration"],
      "requires": "b.occupancy < 2",
      "provides": "c'.boat.occupancy = c.boat.occupancy + 1"
    },
    {
      "name": "DisembarkGuard",
      "description": "Disembarks a guard from the boat to the bank.",
      "inputParameters": ["b: boat", "g: guard"],
      "outputParameters": ["c': configuration"],
      "requires": "b.occupancy > 0",
      "provides": "c'.boat.occupancy = c.boat.occupancy - 1"
