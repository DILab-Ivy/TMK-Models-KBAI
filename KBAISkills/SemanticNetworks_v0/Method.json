      "description": "Moves the boat from one bank to the other.",
      "inputParameters": ["b: boat"],
      "outputParameters": ["b': boat"],
      "requires": "true",
      "provides": "b.position != b'.position"
    },

    {
      "name": "RPMSolution",
      "description": "FSM to solve an Raven’s Progressive Matrices (RPM) problem using Semantic Networks",
      "inputParameters": ["MatrixCells: figure", "Candidates: figure", "Weights: weights"],
      "outputParameters": ["Answer: Candidates"],
      "requires": "MatrixCells != null && Candidates != null",
      "provides": "Answer != null",
      "organizer": {
        "startState": "RPM_S0",
        "successState": "RPM_Success",
        "failureState": "RPM_Fail",
        "states": [
          { "name": "RPM_S0", "goalInvocation": { "goalReference": "RepresentFigures", "type": "task", "actualArguments": ["MatrixCells", "Candidates"] } },
          { "name": "RPM_S1", "goalInvocation": { "goalReference": "RepresentMatrixTransforms", "type": "task", "actualArguments": ["SN_Matrix"] } },
          { "name": "RPM_S2", "goalInvocation": { "goalReference": "RepresentCandidateTransforms", "type": "task", "actualArguments": ["SN_Candidates"] } },
          { "name": "RPM_S3", "goalInvocation": { "goalReference": "CompareTransformPatterns", "type": "task", "actualArguments": ["Matrix_Transform", "Candidate_Transform", "Weights"] } },
          { "name": "RPM_S4", "goalInvocation": { "goalReference": "SelectAnswer", "type": "task", "actualArguments": ["Similarity_Scores", "Candidates"] } },
          { "name": "RPM_Success", "goalInvocation": { "goalReference": "SuccessGoal", "type": "task", "actualArguments": [] } },
          { "name": "RPM_Fail", "goalInvocation": { "goalReference": "FailureGoal", "type": "task", "actualArguments": [] } }
        ],
        "transitions": [
          { "sourceState": "RPM_S0", "targetState": "RPM_S1", "dataCondition": "MatrixCells != null && Candidates != null" },
          { "sourceState": "RPM_S0", "targetState": "RPM_Fail", "dataCondition": "(MatrixCells == null) || (Candidates == null)" },
          { "sourceState": "RPM_S1", "targetState": "RPM_S2", "dataCondition": "SN_Matrix != null" },
          { "sourceState": "RPM_S1", "targetState": "RPM_Fail", "dataCondition": "SN_Matrix == null" },
          { "sourceState": "RPM_S2", "targetState": "RPM_S3", "dataCondition": "SN_Candidates != null" },
          { "sourceState": "RPM_S2", "targetState": "RPM_Fail", "dataCondition": "SN_Candidates == null" },
          { "sourceState": "RPM_S3", "targetState": "RPM_S4", "dataCondition": "Matrix_Transform != null && Candidate_Transform != null" },
          { "sourceState": "RPM_S3", "targetState": "RPM_Fail", "dataCondition": "Matrix_Transform == null || Candidate_Transform == null" },
          { "sourceState": "RPM_S4", "targetState": "RPM_Success", "dataCondition": "Similarity_Scores != null && Candidates != null && answerSelected" },
          { "sourceState": "RPM_S4", "targetState": "RPM_Fail", "dataCondition": "Similarity_Scores == null || Candidates == null || Not answerSelected" }
        ]
      }
    },
    {
      "name": "RepresentFiguresSolution",
      "description": "FSM to represent each matrix cell and candidate to semantic networks representation",
      "inputParameters": ["MatrixCells: figure", "Candidates: figure"],
      "outputParameters": ["SN_Matrix: graph_representation", "SN_Candidates: graph_representation"],
      "requires": "MatrixCells != null && Candidates != null",
      "provides": "SN_Matrix != null && SN_Candidates != null",
      "organizer": {
        "startState": "RFS_S0",
        "successState": "RFS_S3",
        "failureState": "RFS_Fail",
        "states": [
          { "name": "RFS_S0", "goalInvocation": { "goalReference": "RepresentObjectsAsNodes", "type": "operation", "actualArguments": ["cell"] } },
          { "name": "RFS_S1", "goalInvocation": { "goalReference": "LinkRelatedObjects", "type": "operation", "actualArguments": ["node"] } },
          { "name": "RFS_S2", "goalInvocation": { "goalReference": "LabelRelations", "type": "operation", "actualArguments": ["edges"] } },
          { "name": "RFS_S3", "goalInvocation": { "goalReference": "RepeatAboveForEachFigure", "type": "operation", "actualArguments": ["MatrixCells", "Candidates"] } },
          { "name": "RFS_Fail", "goalInvocation": { "goalReference": "FailureGoal", "type": "task", "actualArguments": [] } }
        ],
        "transitions": [
          { "sourceState": "RFS_S0", "targetState": "RFS_S1", "dataCondition": "cell != null" },
