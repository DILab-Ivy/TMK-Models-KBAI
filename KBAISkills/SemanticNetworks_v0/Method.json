{
  "model": "Method",
  "methods": [
    {
      "name": "GPPsolution",
      "description": "FSM to represent optimal solution path for GPP.",
      "inputParameters": ["initialConfiguration: configuration"],
      "outputParameters": ["finalConfiguration: configuration"],
      "requires": "safe(initialConfiguration)",
      "provides": "safe(finalConfiguration)",
      "organizer": {
        "startState": "S0",
        "successState": "S11",
        "failureState": "Fail",
        "states": [
          { "name": "S0", "goalInvocation": { "goalReference": "MoveGuardAndPrisoner", "type": "task", "actualArguments": ["b", "g1", "p1", "initialConfiguration"] } },
          { "name": "S1", "goalInvocation": { "goalReference": "ReturnGuard", "type": "task", "actualArguments": ["b", "g1", "S0"] } },
          { "name": "S2", "goalInvocation": { "goalReference": "MoveTwoPrisoners", "type": "task", "actualArguments": ["b", "p2", "p3", "S1"] } },
          { "name": "S3", "goalInvocation": { "goalReference": "ReturnPrisoner", "type": "task", "actualArguments": ["b", "p1", "S2"] } },
          { "name": "S4", "goalInvocation": { "goalReference": "MoveTwoGuards", "type": "task", "actualArguments": ["b", "g2", "g3", "S3"] } },
          { "name": "S5", "goalInvocation": { "goalReference": "ReturnGuard", "type": "task", "actualArguments": ["b", "g2", "S4"] } },
          { "name": "S6", "goalInvocation": { "goalReference": "MoveGuardAndPrisoner", "type": "task", "actualArguments": ["b", "g2", "p1", "S5"] } },
          { "name": "S7", "goalInvocation": { "goalReference": "ReturnGuardAndPrisoner", "type": "task", "actualArguments": ["b", "g3", "p2", "S6"] } },
          { "name": "S8", "goalInvocation": { "goalReference": "MoveGuardAndPrisoner", "type": "task", "actualArguments": ["b", "g3", "p3", "S7"] } },
          { "name": "S9", "goalInvocation": { "goalReference": "ReturnGuard", "type": "task", "actualArguments": ["b", "g3", "S8"] } },
          { "name": "S10", "goalInvocation": { "goalReference": "MoveTwoGuards", "type": "task", "actualArguments": ["b", "g1", "g3", "S9"] } },
          { "name": "S11", "goalInvocation": { "goalReference": "SafeConfiguration", "type": "task", "actualArguments": ["finalConfiguration"] } },
          { "name": "Fail", "goalInvocation": { "goalReference": "FailureGoal", "type": "task", "actualArguments": [] } }
        ],
        "transitions": [
          { "sourceState": "S0", "targetState": "S1", "dataCondition": "safe(S0) && safe(S1)" },
          { "sourceState": "S0", "targetState": "Fail", "dataCondition": "NOT safe(S0) || NOT safe(S1)" },
          { "sourceState": "S1", "targetState": "S2", "dataCondition": "safe(S1) && safe(S2)" },
          { "sourceState": "S1", "targetState": "Fail", "dataCondition": "NOT safe(S1) || NOT safe(S2)" },
          { "sourceState": "S2", "targetState": "S3", "dataCondition": "safe(S2) && safe(S3)" },
          { "sourceState": "S2", "targetState": "Fail", "dataCondition": "NOT safe(S2) || NOT safe(S3)" },
          { "sourceState": "S3", "targetState": "S4", "dataCondition": "safe(S3) && safe(S4)" },
          { "sourceState": "S3", "targetState": "Fail", "dataCondition": "NOT safe(S3) || NOT safe(S4)" },
          { "sourceState": "S4", "targetState": "S5", "dataCondition": "safe(S4) && safe(S5)" },
          { "sourceState": "S4", "targetState": "Fail", "dataCondition": "NOT safe(S4) || NOT safe(S5)" },
          { "sourceState": "S5", "targetState": "S6", "dataCondition": "safe(S5) && safe(S6)" },
          { "sourceState": "S5", "targetState": "Fail", "dataCondition": "NOT safe(S5) || NOT safe(S6)" },
          { "sourceState": "S6", "targetState": "S7", "dataCondition": "safe(S6) && safe(S7)" },
          { "sourceState": "S6", "targetState": "Fail", "dataCondition": "NOT safe(S6) || NOT safe(S7)" },
          { "sourceState": "S7", "targetState": "S8", "dataCondition": "safe(S7) && safe(S8)" },
          { "sourceState": "S7", "targetState": "Fail", "dataCondition": "NOT safe(S7) || NOT safe(S8)" },
          { "sourceState": "S8", "targetState": "S9", "dataCondition": "safe(S8) && safe(S9)" },
          { "sourceState": "S8", "targetState": "Fail", "dataCondition": "NOT safe(S8) || NOT safe(S9)" },
          { "sourceState": "S9", "targetState": "S10", "dataCondition": "safe(S9) && safe(S10)" },
          { "sourceState": "S9", "targetState": "Fail", "dataCondition": "NOT safe(S9) || NOT safe(S10)" },
          { "sourceState": "S10", "targetState": "S11", "dataCondition": "safe(S10) && safe(S11)" },
