    {
      "name": "SolveRavenProgressiveMatrixProblem",
      "description": "Solve a Raven’s Progressive Matrices (RPM) problem using Semantic Networks via a composed sequence of mechanisms.",
      "inputParameters": ["MatrixCells: figure", "Candidates: figure", "Weights: weights"],
      "outputParameters": ["Answer: Candidates"],
      "given": "MatrixCells != null && Candidates != null && (Weights != null || Weights == default)",
      "makes": "Answer != null",
      "means": [
        { "mechanismReference": "RPMSolution", "actualArguments": ["MatrixCells", "Candidates", "Weights"] }
      ]
    },
    {
      "name": "RepresentFigures",
      "description": "Convert all matrix cells and candidates into per-figure semantic-network graphs.",
      "inputParameters": ["MatrixCells: cells", "Candidates: cells"],
      "outputParameters": ["SN_Matrix: graph_representation", "SN_Candidates: graph_representation"],
      "given": "MatrixCells != null && Candidates != null",
      "makes": "SN_Matrix != null && SN_Candidates != null",
      "means": [
        { "mechanismReference": "RepresentFiguresSolution", "actualArguments": ["MatrixCells", "Candidates", "SN_Matrix", "SN_Candidates"] }
      ]
    },

    {
      "name": "RepresentMatrixTransforms",
      "description": "Build transformation representations across matrix cells (row/column pairings).",
      "inputParameters": ["SN_Matrix: graph_representation"],
      "outputParameters": ["Matrix_Transform: graph_representation"],
      "given": "SN_Matrix != null",
      "makes": "Matrix_Transform != null",
      "means": [
        { "mechanismReference": "RepresentMatrixTransformsSolution", "actualArguments": ["SN_Matrix", "Matrix_Transform"] }
      ]
    },

    {
      "name": "RepresentCandidateTransforms",
      "description": "Build transformation representations for each candidate relative to the target position.",
      "inputParameters": ["SN_Candidates: graph_representation"],
      "outputParameters": ["Candidate_Transform: graph_representation"],
      "given": "SN_Candidates != null",
      "makes": "Candidate_Transform != null",
      "means": [
        { "mechanismReference": "RepresentCandidateTransformsSolution", "actualArguments": ["SN_Candidates", "Candidate_Transform"] }
      ]
    },

    {
      "name": "CompareTransformPatterns",
      "description": "Compare reference (matrix) transforms against candidate transforms and compute weighted similarity scores.",
      "inputParameters": ["Matrix_Transform: graph_representation", "Candidate_Transform: graph_representation", "Weights: weights"],
      "outputParameters": ["Similarity_Scores: float[]"],
      "given": "Matrix_Transform != null && Candidate_Transform != null && (Weights != null || Weights == default)",
      "makes": "Similarity_Scores != null",
      "means": [
        { "mechanismReference": "CompareTransformPatternsSolution", "actualArguments": ["Matrix_Transform", "Candidate_Transform", "Weights", "Similarity_Scores"] }
      ]
    },

    {
      "name": "SelectAnswer",
      "description": "Select the best candidate based on similarity scores and output the chosen answer.",
      "inputParameters": ["Similarity_Scores: float[]", "Candidates: figure"],
      "outputParameters": ["Answer: Candidates"],
      "given": "Similarity_Scores != null && Candidates != null && count(Similarity_Scores) == count(Candidates)",
      "makes": "Answer != null",
      "means": [
        { "mechanismReference": "SelectAnswerSolution", "actualArguments": ["Similarity_Scores", "Candidates", "Answer"] }
      ]
    }
  ]
}
